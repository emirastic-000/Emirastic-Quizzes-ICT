# API Configuration
# For local development
REACT_APP_API_URL=http://localhost:5000/api

# For network access (replace with your machine's IP address)
# Find your IP: Run 'ipconfig' (Windows) or 'ifconfig' (Mac/Linux)
# REACT_APP_API_URL=http://192.168.1.X:5000/api

# Network Access Configuration
# Allow frontend dev server to be accessible from network
# Uncomment the line below for network access
# HOST=0.0.0.0

# SECURITY NOTE: Never commit the actual .env file to version control!
